        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "C",
          "expr": "clamp_min((nms_recipe_need{item=\"$item\"} * on (id, route, recipe_id) group_left() ceil($qty / nms_recipe_yield{item=\"$item\"})) - on (ingredient_id) group_left() ((sum by (ingredient_id) (label_replace(nms_item_total, \"ingredient_id\", \"$1\", \"id\", \"(.*)\"))) or on (ingredient_id) (0 * sum by (ingredient_id) (nms_recipe_need{item=\"$item\"} * on (id, route, recipe_id) group_left() ceil($qty / nms_recipe_yield{item=\"$item\"})))), 0)",
