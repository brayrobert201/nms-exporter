# No Man's Sky save exporter. A template unit instantiated with the Steam user
# (nms-exporter@bob) because it has to read that user's Proton save directory.
[Unit]
Description=No Man's Sky save exporter (%i's saves)
Documentation=https://github.com/brayrobert201/nms-exporter
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=%i
WorkingDirectory=/opt/nms-exporter
# the project's uv environment (pyproject.toml: psycopg for nms-db); install.sh builds it
ExecStart=/opt/nms-exporter/.venv/bin/python /opt/nms-exporter/nms_exporter.py
Environment=NMS_EXPORTER_HOST=0.0.0.0
Environment=NMS_EXPORTER_PORT=9877
Environment=PYTHONUNBUFFERED=1
# Optional: S3 credentials for the versioned save backup (NMS_S3_ACCESS_KEY,
# NMS_S3_SECRET_KEY; root-owned, mode 600). Absent, the backup stays disabled.
EnvironmentFile=-/etc/nms-exporter/s3.env
# Optional: the nms-db Postgres login (PGHOST, PGUSER, PGPASSWORD, ...; written by
# nms-bao-sync, mode 600). Absent, the map's history APIs answer 503.
EnvironmentFile=-/etc/nms-exporter/db.env
# fill-level history (for measured extraction rates) and the cached key mapping
StateDirectory=nms-exporter
CacheDirectory=nms-exporter
Restart=on-failure
RestartSec=5s

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
MemoryMax=512M

[Install]
WantedBy=multi-user.target
