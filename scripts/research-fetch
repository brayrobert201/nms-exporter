#!/usr/bin/env python3
"""Store a web page as a research source: its text, verbatim, with provenance.

    research-fetch URL --slug harvest-all-mod --why "what the mod says it changes"
    research-fetch URL --slug ... --why ... --raw   # also keep the HTML beside it

Writes research/sources/web/<date>-<slug>.md: a header (URL, final URL, date,
HTTP status, sha256 of the body, why) then the page text with scripts, styles
and markup stripped and nothing else changed. Never overwrites; a stored page
is a record of what the source said on that day. Wiki pages: prefer the
MediaWiki raw form (`?action=raw`) so the text is the article, not the chrome.

Standard library only.
"""
from __future__ import annotations

import argparse
import datetime
import gzip
import hashlib
import html
import os
import re
import sys
import urllib.error
import urllib.request
from html.parser import HTMLParser

REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
UA = "Mozilla/5.0 (X11; Linux x86_64) nms-exporter research-fetch"


class Text(HTMLParser):
    SKIP = {"script", "style", "noscript", "svg", "head"}
    BLOCK = {"p", "div", "br", "li", "tr", "h1", "h2", "h3", "h4", "h5", "h6", "pre", "table", "section", "article"}

    def __init__(self):
        super().__init__(convert_charrefs=True)
        self.out, self.skip = [], 0

    def handle_starttag(self, tag, attrs):
        if tag in self.SKIP:
            self.skip += 1
        elif tag in self.BLOCK:
            self.out.append("\n")

    def handle_endtag(self, tag):
        if tag in self.SKIP and self.skip:
            self.skip -= 1
        elif tag in self.BLOCK:
            self.out.append("\n")

    def handle_data(self, data):
        if not self.skip:
            self.out.append(data)

    def text(self) -> str:
        t = "".join(self.out)
        t = re.sub(r"[ \t]+", " ", t)
        return re.sub(r"\n\s*\n+", "\n\n", t).strip()


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("url")
    ap.add_argument("--slug", required=True)
    ap.add_argument("--why", required=True)
    ap.add_argument("--raw", action="store_true", help="also store the HTML as fetched")
    a = ap.parse_args()
    if not re.fullmatch(r"[a-z0-9][a-z0-9-]*", a.slug):
        sys.exit("slug: lowercase letters, digits and hyphens")
    day = datetime.date.today().isoformat()
    dest = os.path.join(REPO, "research/sources/web", f"{day}-{a.slug}.md")
    if os.path.exists(dest):
        sys.exit(f"already stored (never overwritten): {os.path.relpath(dest, REPO)}")
    req = urllib.request.Request(a.url, headers={"User-Agent": UA})
    try:
        with urllib.request.urlopen(req, timeout=30) as r:
            body, status, final = r.read(), r.status, r.geturl()
            ctype = r.headers.get("Content-Type", "")
    except urllib.error.URLError as e:
        sys.exit(f"not stored: {a.url}: {e}")
    if body[:2] == b"\x1f\x8b":            # gzip sent regardless of Accept-Encoding
        body = gzip.decompress(body)
    charset = (re.search(r"charset=([\w-]+)", ctype) or [None, "utf-8"])[1]
    raw = body.decode(charset, errors="replace")
    if "html" in ctype:
        p = Text()
        p.feed(raw)
        text = p.text()
    else:
        text = raw
    os.makedirs(os.path.dirname(dest), exist_ok=True)
    header = (f"<!--\n  source: web\n  url: {a.url}\n  final_url: {final}\n  retrieved: {day}\n"
              f"  http_status: {status}\n  content_type: {ctype}\n"
              f"  sha256: {hashlib.sha256(body).hexdigest()}\n  why: {html.escape(a.why)}\n-->\n\n")
    with open(dest, "w") as f:
        f.write(header + text + "\n")
    if a.raw:
        with open(dest[:-3] + ".html", "wb") as f:
            f.write(body)
    print(os.path.relpath(dest, REPO))


if __name__ == "__main__":
    main()
