#!/usr/bin/env python3
"""Query the extracted game tables (data/nms_tables.json) from the shell.

    nms-data item <name or id>       # what it is, its value, how it is crafted, every refiner recipe in or out
    nms-data recipes <name or id>    # refiner and cooking recipes that make it
    nms-data uses <name or id>       # recipes and blueprints that consume it
    nms-data search <text>           # items whose name or id contains the text
    nms-data crops                   # harvest yield and grow time per crop
    nms-data biomes                  # gas per biome, biome odds per star colour, planet-type labels
    nms-data strings <regex>         # English strings whose key or text match (needs the extractor's work dir)

Standard library only. NMS_TABLES overrides the tables path, NMS_WORK the
extractor's work directory for `strings` (default /tmp/nmsdata).
"""
from __future__ import annotations

import glob
import json
import os
import re
import sys
import xml.etree.ElementTree as ET

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
TABLES = os.environ.get("NMS_TABLES", os.path.join(ROOT, "data", "nms_tables.json"))
WORK = os.environ.get("NMS_WORK", "/tmp/nmsdata")


def load():
    with open(TABLES) as fh:
        return json.load(fh)


def resolve(t, q: str) -> list:
    items = t["items"]
    if q in items:
        return [q]
    ql = q.lower()
    exact = [k for k, v in items.items() if isinstance(v, dict) and v.get("name", "").lower() == ql]
    if exact:
        return exact
    return [k for k, v in items.items() if isinstance(v, dict) and ql in v.get("name", "").lower() or ql in k.lower()]


def nm(t, iid):
    return t["items"].get(iid, {}).get("name", iid)


def fmt_recipe(t, r) -> str:
    ins = " + ".join(f"{i['amount']} {nm(t, i['id'])}" for i in r["ingredients"])
    kind = "cook" if r.get("cooking") else "refine"
    return f"  [{kind}] {ins} -> {r['result']['amount']} {nm(t, r['result']['id'])}   {r['seconds_per_op']}s/op  ({r.get('name') or ''})"


def cmd_item(t, q):
    ids = resolve(t, q)
    if not ids:
        print("no item matches", q)
        return
    for iid in ids[:5]:
        v = t["items"][iid]
        print(f"{iid}: {v.get('name')}  type={v.get('type')} category={v.get('category')} value={v.get('value')}")
        if v.get("price"):
            print(f"  price band x{v['price']['low']}..x{v['price']['high']}, influence {v['price']['influence']}")
        if v.get("craft"):
            print("  craft: " + ", ".join(f"{i['amount']} {nm(t, i['id'])}" for i in v["craft"]["ingredients"]) + f" -> {v['craft']['yield']}")
        makes = [r for r in t["recipes"] if r["result"]["id"] == iid]
        uses = [r for r in t["recipes"] if any(i["id"] == iid for i in r["ingredients"])]
        if makes:
            print(f"  made by {len(makes)} recipes:")
            for r in makes[:12]:
                print(fmt_recipe(t, r))
        if uses:
            print(f"  used in {len(uses)} recipes:")
            for r in uses[:12]:
                print(fmt_recipe(t, r))
        crafts = [(k, c) for k, c in t["items"].items() if isinstance(c, dict) and c.get("craft")
                  and any(i["id"] == iid for i in c["craft"]["ingredients"])]
        if crafts:
            print(f"  ingredient of {len(crafts)} blueprints: " + ", ".join(nm(t, k) for k, _ in crafts[:15]))


def cmd_recipes(t, q):
    for iid in resolve(t, q)[:3]:
        print(f"== {nm(t, iid)} ({iid})")
        for r in t["recipes"]:
            if r["result"]["id"] == iid:
                print(fmt_recipe(t, r))


def cmd_uses(t, q):
    for iid in resolve(t, q)[:3]:
        print(f"== {nm(t, iid)} ({iid})")
        for r in t["recipes"]:
            if any(i["id"] == iid for i in r["ingredients"]):
                print(fmt_recipe(t, r))
        for k, c in t["items"].items():
            if isinstance(c, dict) and c.get("craft") and any(i["id"] == iid for i in c["craft"]["ingredients"]):
                print(f"  [craft] {nm(t, k)} (value {c.get('value')}): " + ", ".join(f"{i['amount']} {nm(t, i['id'])}" for i in c["craft"]["ingredients"]))


def cmd_search(t, q):
    for iid in resolve(t, q)[:40]:
        v = t["items"][iid]
        print(f"{iid:28s} {v.get('name'):40s} {v.get('type'):12s} value={v.get('value')}")


def cmd_crops(t, _):
    for pid, c in sorted(t.get("crops", {}).items(), key=lambda kv: kv[1].get("grow_seconds") or 0):
        print(f"{c['plant']:20s} {c['amount']:4d} {c['yields']:16s} every {(c.get('grow_seconds') or 0) / 3600:4.1f} h")


def cmd_biomes(t, _):
    ext = t["extraction"]
    print("gas hotspots per biome (gas1, gas2):")
    for b, g in ext.get("biome_gases", {}).items():
        print(f"  {b:12s} {nm(t, g['gas1']):12s} {nm(t, g['gas2'])}")
    p = t.get("planets", {})
    print("\nbiome weights per star colour:")
    for star, w in p.get("biomes_by_star", {}).items():
        print(f"  {star:16s} " + ", ".join(f"{b} {x:g}" for b, x in w.items() if x))
    print("\nplanet-type labels:")
    for b, labels in p.get("labels", {}).items():
        print(f"  {b:12s} " + "; ".join(labels))


def cmd_strings(t, q):
    rx = re.compile(q, re.I)
    paths = [os.path.join(r, f) for r, _, fs in os.walk(WORK) for f in fs
             if f.lower().startswith("nms_") and "english" in f.lower() and f.lower().endswith(".mxml")]
    if not paths:
        print(f"no language tables under {WORK}; run scripts/nms-extract-tables.py first")
        return
    n = 0
    for path in paths:
        for e in ET.parse(path).getroot().iter("Property"):
            if e.get("value") == "TkLocalisationEntry":
                pp = {c.get("name"): c for c in e.findall("Property")}
                key = pp["Id"].get("value") if "Id" in pp else ""
                eng = pp["English"].get("value") if "English" in pp else ""
                if rx.search(key or "") or rx.search(eng or ""):
                    print(f"{key:40s} {eng!r}"[:200])
                    n += 1
                    if n >= 200:
                        return


def main():
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help"):
        print(__doc__)
        return
    cmd, arg = sys.argv[1], " ".join(sys.argv[2:])
    fn = {"item": cmd_item, "recipes": cmd_recipes, "uses": cmd_uses, "search": cmd_search,
          "crops": cmd_crops, "biomes": cmd_biomes, "strings": cmd_strings}.get(cmd)
    if not fn:
        print(__doc__)
        return
    fn(load(), arg)


if __name__ == "__main__":
    main()
