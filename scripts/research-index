#!/usr/bin/env python3
"""Regenerate research/questions/index.md and knowledge/index.md from frontmatter.

    research-index

Both files are generated; edit the question and concept files, not these.
Standard library only; reuses okf-lint's frontmatter reader.
"""
from __future__ import annotations

import importlib.machinery
import importlib.util
import os

HERE = os.path.dirname(os.path.abspath(__file__))
REPO = os.path.dirname(HERE)
_loader = importlib.machinery.SourceFileLoader("okf_lint", os.path.join(HERE, "okf-lint"))
_spec = importlib.util.spec_from_loader("okf_lint", _loader)
lint = importlib.util.module_from_spec(_spec)
_loader.exec_module(lint)

ORDER = {"open": 0, "partial": 1, "answered": 2, "dropped": 3}
SECTIONS = [("mechanics", "Mechanics"), ("data-locations", "Data locations"), ("tools", "Tools")]
NOTE = "<!-- generated by scripts/research-index; edit the files it lists, not this -->\n\n"



def _read(path, **kw):
    with open(path, **kw) as f:
        return f.read()


def _write(path, text):
    with open(path, "w") as f:
        f.write(text)

def rows(d: str):
    for f in sorted(os.listdir(d)):
        if f.endswith(".md") and f not in lint.SKIP:
            fm = lint.frontmatter(os.path.join(d, f)) or {}
            yield f, fm


def questions():
    d = os.path.join(REPO, "research/questions")
    items = sorted(rows(d), key=lambda r: (ORDER.get(r[1].get("status"), 9), r[0]))
    out = ["# Questions\n\n", NOTE, "| Status | Question | Decides |\n|---|---|---|\n"]
    for f, fm in items:
        out.append(f"| {fm.get('status', '?')} | [{fm.get('title', f)}]({f}) | {fm.get('decides', '')} |\n")
    _write(os.path.join(d, "index.md"), "".join(out))


def knowledge():
    k = os.path.join(REPO, "knowledge")
    out = ["# No Man's Sky mechanics compendium\n\n", NOTE,
           "Conventions: [meta/conventions.md](meta/conventions.md). Changes: [log.md](log.md). ",
           "Open questions: [../research/questions/index.md](../research/questions/index.md).\n"]
    for sub, title in SECTIONS:
        d = os.path.join(k, sub)
        if not os.path.isdir(d):
            continue
        out.append(f"\n## {title}\n\n| Concept | Evidence | Builds | Status |\n|---|---|---|---|\n")
        for f, fm in rows(d):
            builds = ", ".join(fm.get("builds") or []) or "-"
            out.append(f"| [{fm.get('title', f)}]({sub}/{f}) | {fm.get('evidence_level', '?')} | {builds} | {fm.get('status', '?')} |\n")
    _write(os.path.join(k, "index.md"), "".join(out))


if __name__ == "__main__":
    questions()
    knowledge()
    print("wrote research/questions/index.md and knowledge/index.md")
