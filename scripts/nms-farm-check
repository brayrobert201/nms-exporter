#!/usr/bin/env python3
"""Find extractors that are not properly hooked up, and say where they are.

    nms-farm-check                 # every base with extractors
    nms-farm-check "Cobalt Oxygen" # bases whose name contains the text
    nms-farm-check --all           # also list the extractors that look fine

Reads the exporter's /raw/bases (the decoded base list of the newest save).
For each extractor it checks:

- **not piped**    no pipeline end within reach: it fills its own 250 and stops
- **no depot**     piped, but nothing on its pipe network is a supply depot
- **no wire**      no power line ends at it (both extractor types need 50 kP)
- **never filled** its buffer is empty: unpowered, off the hotspot, or just
                   built. On a network all extractors share one fill, so a
                   whole network at 0 shows as several.

Whether a wired extractor's power actually reaches a generator is not
checked: on several working farms the wires visibly stop short of the
generators in the save (power passes through parts or snap points the save
does not describe), so a whole-network power trace gives false alarms.

Extractors at 250/250 are normal: an extractor's own buffer stays full while
its network's depots fill. Full depots are the exporter's farm rows.

Positions are relative to the base computer in the base's own frame (y up);
`gap` is the distance from the extractor to the nearest pipe or wire end, so a
small gap is a pipe that stops just short.

Standard library only. NMS_EXPORTER_URL overrides http://127.0.0.1:9877.
"""
from __future__ import annotations

import json
import os
import sys
import urllib.request

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
from nmsexporter.farmcheck import check_base  # noqa: E402

URL = os.environ.get("NMS_EXPORTER_URL", "http://127.0.0.1:9877")
URL = os.environ.get("NMS_EXPORTER_URL", "http://127.0.0.1:9877")


def main():
    args = [a for a in sys.argv[1:] if not a.startswith("--")]
    show_all = "--all" in sys.argv
    try:
        with urllib.request.urlopen(URL + "/raw/bases", timeout=10) as r:
            bases = json.load(r)
    except Exception as e:
        sys.exit(f"nms-exporter not reachable at {URL}: {e}")
    bad = 0
    for b in bases:
        name = b.get("Name") or "unnamed"
        if args and not any(a.lower() in name.lower() for a in args):
            continue
        rows = check_base(b)
        if not rows:
            continue
        probs = [r for r in rows if r["problems"]]
        bad += len(probs)
        print(f"== {name}: {len(rows)} extractors, {len(probs)} with problems")
        for r in (rows if show_all else probs):
            flag = ", ".join(r["problems"]) or "ok"
            print(f"  {r['kind']:7s} {flag:26s} {r['from_computer_m']:4d} m from computer "
                  f"(x {r['x']:+d}, z {r['z']:+d}, {r['height_m']:+d} m up)  "
                  f"network of {r['network_size']}, fill {r['fill_items']}/250, "
                  f"pipe gap {r['pipe_gap_m']}, wire gap {r['wire_gap_m']}")
            nn = r.get("nearest_network")
            if nn:
                print(f"          {nn[0]:.0f} m from the nearest {nn[1]} network ({nn[2]} extractors)")
    print(f"{bad} extractor(s) need attention")


if __name__ == "__main__":
    main()
