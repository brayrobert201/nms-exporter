#!/usr/bin/env python3
"""Find extractors that are not properly hooked up, and say where they are.

    nms-farm-check                 # every base with extractors
    nms-farm-check "Cobalt Oxygen" # bases whose name contains the text
    nms-farm-check --all           # also list the extractors that look fine

Reads the exporter's /raw/bases (the decoded base list of the newest save).
For each extractor it checks:

- **not piped**    no pipeline end within reach: it fills its own 250 and stops
- **no depot**     piped, but nothing on its pipe network is a supply depot
- **split off**    traced onto a network by geometry, but it alone carries a
                   different fill, so the game does not count it as connected
                   (a gap the geometry tolerance hides). A *group* of
                   extractors sharing a different fill is a separate network
                   that happens to touch (stacked layers), and is not flagged.
- **no wire**      no power line ends at it (both extractor types need 50 kP)
- **never filled** its buffer is empty: unpowered, off the hotspot, or just
                   built. On a network all extractors share one fill, so a
                   whole network at 0 shows as several.

Whether a wired extractor's power actually reaches a generator is not
checked: on several working farms the wires visibly stop short of the
generators in the save (power passes through parts or snap points the save
does not describe), so a whole-network power trace gives false alarms.

Extractors at 250/250 are normal: an extractor's own buffer stays full while
its network's depots fill. Full depots are the exporter's farm rows.

Positions are relative to the base computer in the base's own frame (y up);
`gap` is the distance from the extractor to the nearest pipe or wire end, so a
small gap is a pipe that stops just short.

Standard library only. NMS_EXPORTER_URL overrides http://127.0.0.1:9877.
"""
from __future__ import annotations

import json
import math
import os
import sys
import urllib.request

URL = os.environ.get("NMS_EXPORTER_URL", "http://127.0.0.1:9877")
EXTRACTORS = {"^U_EXTRACTOR_S": "mineral", "^U_GASEXTRACTOR": "gas"}
DEPOT = "^U_SILO_S"
UNITS_PER_ITEM = 1440
PIPE_TOL = 3.2              # the game joins within 3; same tolerance as the exporter
WIRE_TOL = 2.5              # wire ends sit 0.2-2.2 from the part they feed (measured)


def fill(o) -> int:
    return o.get("UserData", 0) >> 32


def ends(seg) -> list:
    a = seg["Position"]
    return [a, [a[k] + seg["At"][k] for k in range(3)]]


class Graph:
    def __init__(self):
        self.parent = {}

    def find(self, x):
        while self.parent.setdefault(x, x) != x:
            self.parent[x] = self.parent[self.parent[x]]
            x = self.parent[x]
        return x

    def union(self, a, b):
        self.parent[self.find(a)] = self.find(b)


def trace(nodes: list, segs: list, tol: float) -> Graph:
    """Union nodes (indexes into nodes) and segments whose ends come within tol."""
    g = Graph()
    pts = [(i, e) for i, s in enumerate(segs) for e in ends(s)]
    for i, e in pts:
        g.find(("s", i))
        for j, n in enumerate(nodes):
            if math.dist(e, n["Position"]) < tol:
                g.union(("s", i), ("n", j))
        for i2, e2 in pts:
            if i2 != i and math.dist(e, e2) < tol:
                g.union(("s", i), ("s", i2))
    return g


def nearest_end(p, segs) -> float | None:
    ds = [math.dist(p, e) for s in segs for e in ends(s)]
    return min(ds) if ds else None


def check_base(b: dict) -> list:
    objs = b.get("Objects", [])
    exts = [o for o in objs if o["ObjectID"] in EXTRACTORS]
    if not exts:
        return []
    computer = next((o for o in objs if o["ObjectID"] == "^BASE_FLAG"), None)
    origin = computer["Position"] if computer else [0.0, 0.0, 0.0]
    pipes = [o for o in objs if o["ObjectID"] == "^U_PIPELINE"]
    wires = [o for o in objs if o["ObjectID"] == "^U_POWERLINE"]

    res = [o for o in objs if o["ObjectID"] in EXTRACTORS or o["ObjectID"] == DEPOT]
    pg = trace(res, pipes, PIPE_TOL)
    pipe_comp = {}
    for j, o in enumerate(res):
        pipe_comp.setdefault(pg.find(("n", j)), []).append(o)
    piped = {id(o) for j, o in enumerate(res)
             if any(pg.find(("s", i)) == pg.find(("n", j)) for i in range(len(pipes)))}

    wired = {id(o) for o in exts
             if any(math.dist(e, o["Position"]) < WIRE_TOL for w in wires for e in ends(w))}

    networks = [[o for o in c if o["ObjectID"] in EXTRACTORS] for c in pipe_comp.values()]
    networks = [n for n in networks if len(n) > 1]

    def nearest_network(o):
        best = None
        for n in networks:
            if any(x is o for x in n):
                continue
            d = min(math.dist(o["Position"], x["Position"]) for x in n)
            if best is None or d < best[0]:
                best = (d, EXTRACTORS[n[0]["ObjectID"]], len(n))
        return best

    rows = []
    for comp in pipe_comp.values():
        cexts = [o for o in comp if o["ObjectID"] in EXTRACTORS]
        has_depot = any(o["ObjectID"] == DEPOT for o in comp)
        fills = [fill(o) for o in cexts]
        lone = {f for f in set(fills) if fills.count(f) == 1} if len(set(fills)) > 1 else set()
        for o in cexts:
            problems = []
            if id(o) not in piped:
                problems.append("not piped")
            elif not has_depot:
                problems.append("no depot")
            if id(o) in piped and fill(o) in lone:
                problems.append("split off")
            if id(o) not in wired:
                problems.append("no wire")
            if fill(o) == 0:
                problems.append("never filled")
            rel = [o["Position"][k] - origin[k] for k in range(3)]
            gap_p = nearest_end(o["Position"], pipes)
            gap_w = nearest_end(o["Position"], wires)
            rows.append({
                "kind": EXTRACTORS[o["ObjectID"]], "problems": problems,
                "network_size": len(cexts), "fill_items": fill(o) // UNITS_PER_ITEM,
                "from_computer_m": round(math.hypot(rel[0], rel[2])), "height_m": round(rel[1]),
                "x": round(rel[0]), "z": round(rel[2]),
                "pipe_gap_m": None if gap_p is None else round(gap_p, 1),
                "wire_gap_m": None if gap_w is None else round(gap_w, 1),
                "nearest_network": nearest_network(o) if problems else None,
            })
    return sorted(rows, key=lambda r: (not r["problems"], r["kind"], r["from_computer_m"]))


def main():
    args = [a for a in sys.argv[1:] if not a.startswith("--")]
    show_all = "--all" in sys.argv
    try:
        with urllib.request.urlopen(URL + "/raw/bases", timeout=10) as r:
            bases = json.load(r)
    except Exception as e:
        sys.exit(f"nms-exporter not reachable at {URL}: {e}")
    bad = 0
    for b in bases:
        name = b.get("Name") or "unnamed"
        if args and not any(a.lower() in name.lower() for a in args):
            continue
        rows = check_base(b)
        if not rows:
            continue
        probs = [r for r in rows if r["problems"]]
        bad += len(probs)
        print(f"== {name}: {len(rows)} extractors, {len(probs)} with problems")
        for r in (rows if show_all else probs):
            flag = ", ".join(r["problems"]) or "ok"
            print(f"  {r['kind']:7s} {flag:26s} {r['from_computer_m']:4d} m from computer "
                  f"(x {r['x']:+d}, z {r['z']:+d}, {r['height_m']:+d} m up)  "
                  f"network of {r['network_size']}, fill {r['fill_items']}/250, "
                  f"pipe gap {r['pipe_gap_m']}, wire gap {r['wire_gap_m']}")
            nn = r.get("nearest_network")
            if nn:
                print(f"          {nn[0]:.0f} m from the nearest {nn[1]} network ({nn[2]} extractors)")
    print(f"{bad} extractor(s) need attention")


if __name__ == "__main__":
    main()
